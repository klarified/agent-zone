{
  "default": "middle",
  "notAppCode": [
    "**/*.Tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "**/fixtures/**",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/*.md",
    "docs/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/packages.lock.json",
    "**/*.Designer.cs",
    "**/*ModelSnapshot.cs",
    "**/*.g.cs",
    "**/*.generated.*",
    "**/*.min.js",
    "**/*.min.css",
    "**/dist/**",
    "**/build/**"
  ],
  "zones": {
    "core": {
      "paths": [
        "services/payments/**",
        "services/auth/**",
        "**/Migrations/**"
      ]
    },
    "middle": {},
    "surface": {
      "paths": [
        "web/src/components/**",
        "tools/**",
        "docs/**",
        "**/*.Tests/**",
        "**/*.test.*",
        "**/*.spec.*"
      ]
    }
  }
}
