{
  "default": "middle",
  "ignore": [
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/packages.lock.json",
    "**/*.Designer.cs",
    "**/*ModelSnapshot.cs",
    "**/*.g.cs",
    "**/*.generated.*",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.snap",
    "**/__snapshots__/**",
    "**/dist/**",
    "**/build/**"
  ],
  "zones": {
    "core": {
      "paths": [
        "services/payments/**",
        "services/auth/**",
        "**/Migrations/**"
      ],
      "maxAddedLines": 200
    },
    "middle": {
      "maxAddedLines": 400
    },
    "surface": {
      "paths": [
        "web/src/components/**",
        "tools/**",
        "docs/**",
        "**/*.Tests/**",
        "**/*.test.*",
        "**/*.spec.*"
      ],
      "maxAddedLines": 800
    }
  }
}
